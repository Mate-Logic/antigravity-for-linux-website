---
// Header.astro - Encabezado principal simplificado
---

<header class="border-b border-zinc-800/80 bg-[#08080a] sticky top-0 z-40 backdrop-blur-md bg-opacity-90">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Brand & Logo -->
    <div class="flex items-center space-x-3">
      <img src="/images/Antigravity_CLI.svg" alt="Antigravity CLI Logo" class="w-9 h-9 object-contain drop-shadow-md" />
      <div class="flex items-center space-x-2">
        <span class="font-bold text-white text-lg tracking-tight">Antigravity</span>
        <span class="text-xs text-blue-400 font-mono bg-blue-950/60 border border-blue-800/40 px-2 py-0.5 rounded">Linux</span>
      </div>
    </div>

    <!-- Right Side Badges & Account -->
    <div class="flex items-center space-x-4 text-xs">
      <div class="hidden sm:flex items-center space-x-2 bg-zinc-900 border border-zinc-800 px-2.5 py-1 rounded-md">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-zinc-300 font-mono">v1.4.0 (Latest Release)</span>
      </div>

      <div class="text-zinc-400 font-mono text-[11px] hidden md:block">
        berramuspegonzalez@gmail.com
      </div>
    </div>
  </div>
</header>
