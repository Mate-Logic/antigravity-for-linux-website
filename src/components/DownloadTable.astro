---
type ReleaseAsset = {
  name: string;
  browser_download_url: string;
  digest?: string | null;
};

type GithubRelease = {
  name: string;
  html_url: string;
  assets: ReleaseAsset[];
};

const fallbackRelease = {
  version: '2.1.1',
  releaseUrl: 'https://github.com/Mate-Logic/Antigravity-AppImage/releases/latest',
  downloadUrl:
    'https://github.com/Mate-Logic/Antigravity-AppImage/releases/download/latest/AntigravityIDE-x86_64.AppImage',
  sha256: '93ee7205886e885b54c26d3292441e7977d27e5e8bd25a893a79a087502df3f6',
};

const release = await (async () => {
  try {
    const response = await fetch(
      'https://api.github.com/repos/Mate-Logic/Antigravity-AppImage/releases/latest',
      { headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'antigravity-for-linux-website' } },
    );
    if (!response.ok) throw new Error(`GitHub API returned ${response.status}`);

    const data = (await response.json()) as GithubRelease;
    const appImage = data.assets.find(
      (asset) => asset.name.endsWith('.AppImage') && !asset.name.endsWith('.AppImage.zsync'),
    );
    if (!appImage) throw new Error('The latest release has no AppImage asset');

    const version = data.name.match(/(\d+(?:\.\d+)+)/)?.[1] ?? fallbackRelease.version;
    const sha256 = appImage.digest?.replace(/^sha256:/, '') ?? '';
    if (!sha256) throw new Error('The AppImage asset has no SHA-256 digest');

    return {
      version,
      releaseUrl: data.html_url,
      downloadUrl: appImage.browser_download_url,
      sha256,
    };
  } catch (error) {
    console.warn(`Could not load the latest GitHub release: ${error}`);
    return fallbackRelease;
  }
})();
---

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Card 1: Antigravity 2.0 (Desktop Agent - No-IDE) -->
  <div class="border border-purple-800/50 rounded-2xl bg-gradient-to-b from-[#120d1c] to-[#0c0a12] p-6 space-y-6 shadow-2xl relative overflow-hidden flex flex-col justify-between group hover:border-purple-600/60 transition-all">
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div class="w-12 h-12 rounded-xl bg-purple-950/80 border border-purple-700/50 flex items-center justify-center shrink-0 shadow-lg p-2 group-hover:scale-105 transition-transform">
          <img src={`${import.meta.env.BASE_URL}images/Google-Antigravity-Icon-White.png`} alt="Antigravity 2.0 Logo" class="w-full h-full object-contain" />
        </div>
        <div class="flex items-center space-x-1.5">
          <span class="text-[10px] bg-purple-950 text-purple-300 border border-purple-700/60 px-2 py-0.5 rounded-full font-mono font-semibold" data-i18n="v2-tag">Desktop Agent</span>
          <span class="text-[9px] bg-emerald-950 text-emerald-400 border border-emerald-800/50 px-2 py-0.5 rounded-full font-mono font-medium" data-i18n="recommended">Recommended</span>
        </div>
      </div>

      <div>
        <h3 class="text-xl font-bold text-white tracking-tight">Antigravity 2.0</h3>
        <p class="text-xs text-zinc-400 mt-2 leading-relaxed" data-i18n="v2-desc">
          Standalone AI desktop agent application (Non-IDE) for Linux. Instant native execution in 64-bit portable AppImage format.
        </p>
      </div>

      <div class="space-y-2 font-mono text-xs pt-2">
        <div class="bg-[#090710] border border-purple-950 p-2.5 rounded-lg flex items-center justify-between text-[11px]">
          <span class="text-zinc-500" data-i18n="format-label">Format:</span>
          <span class="text-purple-300 font-semibold">x86_64 (.AppImage)</span>
        </div>
        <div class="bg-[#090710] border border-purple-950 p-2.5 rounded-lg flex items-center justify-between text-[11px]">
          <span class="text-zinc-500" data-i18n="sha256-label">SHA-256:</span>
          <button 
            data-copy="sha256-v2" 
            data-hash="9c2d1e4b3017fa98e3b2c1d0f97e6f5d4c3b2a1098987b6c5d4e3f2a1b0c9a8f"
            class="copy-btn text-purple-300 hover:text-white transition-colors"
          >
            9c2d1e4b... 📋
          </button>
        </div>
      </div>
    </div>

    <a
      href="#install-modal"
      data-modal-open="appimage-2"
      class="bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold py-3 px-4 rounded-xl shadow-lg shadow-purple-600/30 transition-all flex items-center justify-center space-x-2 active:scale-95 w-full mt-4"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
      </svg>
      <span data-i18n="v2-btn">Download AppImage 2.0 (x64)</span>
    </a>
  </div>

  <!-- Card 2: Antigravity IDE (Full IDE - AppImage x64) -->
  <div class="border border-zinc-800/80 rounded-2xl bg-gradient-to-b from-[#0e0e12] to-[#08080a] p-6 space-y-6 shadow-xl relative overflow-hidden flex flex-col justify-between group hover:border-blue-600/50 transition-all">
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div class="w-12 h-12 rounded-xl bg-blue-950/60 border border-blue-800/40 flex items-center justify-center shrink-0 shadow-lg p-2 group-hover:scale-105 transition-transform">
          <img src={`${import.meta.env.BASE_URL}images/Google-Antigravity-Icon-Full-Color.png`} alt="Antigravity IDE Logo" class="w-full h-full object-contain" />
        </div>
        <span class="text-[10px] bg-blue-950 text-blue-400 border border-blue-800/60 px-2 py-0.5 rounded-full font-mono font-semibold" data-i18n="ide-tag">Full IDE</span>
      </div>

      <div>
        <h3 class="text-xl font-bold text-white tracking-tight">
          Antigravity IDE <a href={release.releaseUrl} class="text-blue-400 hover:text-blue-300" target="_blank" rel="noopener noreferrer">v{release.version}</a>
        </h3>
        <p class="text-xs text-zinc-400 mt-2 leading-relaxed" data-i18n="ide-desc">
          Complete development environment for Linux packaged as a 64-bit portable AppImage derived from official releases.
        </p>
      </div>

      <div class="space-y-2 font-mono text-xs pt-2">
        <div class="bg-[#050507] border border-zinc-800/80 p-2.5 rounded-lg flex items-center justify-between text-[11px]">
          <span class="text-zinc-500" data-i18n="format-label">Format:</span>
          <span class="text-zinc-300 font-semibold">x86_64 (.AppImage)</span>
        </div>
        <div class="bg-[#050507] border border-zinc-800/80 p-2.5 rounded-lg flex items-center justify-between text-[11px]">
          <span class="text-zinc-500" data-i18n="sha256-label">SHA-256:</span>
          <button 
            data-copy="sha256-appimage" 
            data-hash={release.sha256}
            class="copy-btn text-zinc-300 hover:text-white transition-colors"
          >
            {release.sha256.slice(0, 12)}... 📋
          </button>
        </div>
      </div>
    </div>

    <a
      href={release.downloadUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="bg-[#0066ff] hover:bg-blue-500 text-white text-xs font-semibold py-3 px-4 rounded-xl shadow-lg shadow-blue-600/20 transition-all flex items-center justify-center space-x-2 active:scale-95 w-full mt-4"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
      </svg>
      <span data-i18n="ide-btn" data-release-version={release.version}>Download AppImage IDE v{release.version} (x64)</span>
    </a>
  </div>

  <!-- Card 3: Antigravity CLI (Official Google Install) -->
  <div class="border border-zinc-800/80 rounded-2xl bg-gradient-to-b from-[#0d1410] to-[#080a08] p-6 space-y-6 shadow-xl relative overflow-hidden flex flex-col justify-between group hover:border-emerald-600/50 transition-all">
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div class="w-12 h-12 rounded-xl bg-emerald-950/60 border border-emerald-800/40 flex items-center justify-center shrink-0 shadow-lg p-2 group-hover:scale-105 transition-transform">
          <img src={`${import.meta.env.BASE_URL}images/Antigravity_CLI.svg`} alt="Antigravity CLI Logo" class="w-full h-full object-contain" />
        </div>
        <span class="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800/60 px-2 py-0.5 rounded-full font-mono font-semibold" data-i18n="cli-tag">Official Google</span>
      </div>

      <div>
        <h3 class="text-xl font-bold text-white tracking-tight">Antigravity CLI</h3>
        <p class="text-xs text-zinc-400 mt-2 leading-relaxed" data-i18n="cli-desc">
          Official command-line interface for Linux. Direct installation via official Google script.
        </p>
      </div>

      <div class="bg-[#050806] border border-emerald-950/80 p-3 rounded-lg font-mono text-xs text-emerald-400 overflow-x-auto">
        <div class="text-[10px] text-zinc-500 mb-1" data-i18n="cli-cmd-label">Terminal Command:</div>
        <code class="text-zinc-200 text-[11px] block truncate">curl -fsSL https://antigravity.google/cli/install.sh | bash</code>
      </div>
    </div>

    <button 
      data-copy="cli-official-script"
      data-text="curl -fsSL https://antigravity.google/cli/install.sh | bash"
      class="copy-btn bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold py-3 px-4 rounded-xl shadow-lg shadow-emerald-600/20 transition-all flex items-center justify-center space-x-2 active:scale-95 w-full mt-4"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002-2V7a2 2 0 002-2h2m0 0h2a2 2 0 012 2v1h-4V7a2 2 0 012-2zm2 5h4m-4 4h4m-4 4h4"></path>
      </svg>
      <span data-i18n="cli-btn">Copy Command</span>
    </button>
  </div>

</div>
