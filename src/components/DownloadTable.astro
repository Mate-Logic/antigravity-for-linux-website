---
type ReleaseAsset = {
  name: string;
  browser_download_url: string;
  digest?: string | null;
};

type GithubRelease = {
  name: string;
  html_url: string;
  body?: string;
  assets: ReleaseAsset[];
};

type ReleaseInfo = {
  version: string;
  releaseUrl: string;
  downloadUrl: string;
  sha256: string;
};

async function fetchLatestRelease(
  repo: string,
  fallback: ReleaseInfo,
): Promise<ReleaseInfo> {
  try {
    const response = await fetch(`https://api.github.com/repos/${repo}/releases/latest`, {
      headers: {
        Accept: 'application/vnd.github+json',
        'User-Agent': 'antigravity-for-linux-website',
      },
    });
    if (!response.ok) throw new Error(`GitHub API returned ${response.status}`);

    const data = (await response.json()) as GithubRelease;
    const appImage = data.assets.find(
      (asset) => asset.name.endsWith('.AppImage') && !asset.name.endsWith('.AppImage.zsync'),
    );
    if (!appImage) throw new Error('The latest release has no AppImage asset');

    const versionMatches = data.name.match(/(\d+\.\d+(?:\.\d+)*)/g);
    const version = versionMatches ? versionMatches[versionMatches.length - 1] : fallback.version;
    
    let sha256 = appImage.digest?.replace(/^sha256:/, '') ?? '';
    if (!sha256 && data.body) {
      const match = data.body.match(/`([a-fA-F0-9]{64})`/);
      if (match) sha256 = match[1];
    }
    if (!sha256) sha256 = fallback.sha256;

    return {
      version,
      releaseUrl: data.html_url,
      downloadUrl: appImage.browser_download_url,
      sha256,
    };
  } catch (error) {
    console.warn(`Could not load latest release for ${repo}: ${error}`);
    return fallback;
  }
}

const v2Release = await fetchLatestRelease('Mate-Logic/Antigravity2.0-AppImage', {
  version: '2.7.1',
  releaseUrl: 'https://github.com/Mate-Logic/Antigravity2.0-AppImage/releases/tag/latest',
