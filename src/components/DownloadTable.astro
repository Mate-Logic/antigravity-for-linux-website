---
// DownloadTable.astro - Segmentación de productos: Antigravity 2.0 (Desktop Agent), Antigravity IDE y Antigravity CLI
---

<div class="space-y-8">

  <!-- Product 1: Antigravity 2.0 (Desktop Agent - No-IDE) -->
  <div class="border border-purple-800/50 rounded-xl bg-[#0e0c14] p-6 space-y-5 shadow-2xl relative overflow-hidden ring-1 ring-purple-600/20">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-purple-900/40 pb-5">
      <div class="flex items-start space-x-4">
        <div class="w-12 h-12 rounded-xl bg-purple-950/80 border border-purple-700/50 flex items-center justify-center shrink-0 shadow-lg p-1.5">
          <img src="/images/Antigravity_CLI.svg" alt="Antigravity 2.0 Logo" class="w-full h-full object-contain drop-shadow" />
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h3 class="text-xl font-bold text-white tracking-tight">Antigravity 2.0</h3>
            <span class="text-[10px] bg-purple-950 text-purple-300 border border-purple-700/60 px-2 py-0.5 rounded font-mono font-semibold">Desktop Agent (No-IDE)</span>
            <span class="text-[9px] bg-emerald-950 text-emerald-400 border border-emerald-800/50 px-1.5 py-0.5 rounded font-mono font-medium">Recomendado</span>
          </div>
          <p class="text-xs text-zinc-300 mt-1 max-w-xl">
            Aplicación de escritorio independiente tipo agente autónomo de IA (No-IDE) para Linux. Ejecución instantánea en formato portable <code class="text-purple-300 bg-purple-950/80 px-1 py-0.5 rounded font-mono">.AppImage</code> de 64 bits.
          </p>
        </div>
      </div>

      <!-- AppImage Download Action Button for 2.0 -->
      <a
        href="#install-modal"
        data-modal-open="appimage-2"
        class="bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold px-5 py-2.5 rounded-lg shadow-lg shadow-purple-600/30 transition-all flex items-center justify-center space-x-2 active:scale-95 shrink-0"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        <span>Descargar AppImage 2.0 (x64)</span>
      </a>
    </div>

    <!-- Details Row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono pt-1 text-zinc-400">
      <div class="bg-[#08070c] border border-purple-900/30 p-3 rounded-md">
        <div class="text-[10px] text-purple-400/80 uppercase font-sans font-semibold">Tipo de Aplicación</div>
        <div class="text-zinc-200 font-semibold font-sans mt-0.5">Agente de Escritorio Autónomo</div>
      </div>
      <div class="bg-[#08070c] border border-purple-900/30 p-3 rounded-md">
        <div class="text-[10px] text-purple-400/80 uppercase font-sans font-semibold">Arquitectura & Formato</div>
        <div class="text-zinc-200 font-semibold font-sans mt-0.5">Linux x86_64 (.AppImage)</div>
      </div>
      <div class="bg-[#08070c] border border-purple-900/30 p-3 rounded-md flex items-center justify-between">
        <div>
          <div class="text-[10px] text-purple-400/80 uppercase font-sans font-semibold">Hash SHA-256</div>
          <div class="text-zinc-300 text-[11px] truncate max-w-[120px]">9c2d1e4b3017...</div>
        </div>
        <button 
          data-copy="sha256-v2" 
          data-hash="9c2d1e4b3017fa98e3b2c1d0f97e6f5d4c3b2a1098987b6c5d4e3f2a1b0c9a8f"
          class="copy-btn px-2 py-1 text-[10px] bg-purple-950/80 hover:bg-purple-900 text-purple-200 border border-purple-800/50 rounded transition-colors"
          title="Copiar Hash SHA-256"
        >
          SHA-256 📋
        </button>
      </div>
    </div>
  </div>

  <!-- Product 2: Antigravity IDE (AppImage x64) -->
  <div class="border border-zinc-800/80 rounded-xl bg-[#0c0c0e] p-6 space-y-5 shadow-xl relative overflow-hidden">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-800/80 pb-5">
      <div class="flex items-start space-x-3.5">
        <div class="w-10 h-10 rounded-lg bg-blue-950/80 border border-blue-800/50 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
          </svg>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h3 class="text-lg font-bold text-white tracking-tight">Antigravity IDE</h3>
            <span class="text-[10px] bg-blue-950 text-blue-400 border border-blue-800/60 px-2 py-0.5 rounded font-mono font-medium">IDE Completo</span>
          </div>
          <p class="text-xs text-zinc-400 mt-1">
            Entorno de desarrollo integral para Linux empaquetado en formato portable <code class="text-zinc-300 bg-zinc-900 px-1 py-0.5 rounded font-mono">.AppImage</code> de 64 bits.
          </p>
        </div>
      </div>

      <!-- AppImage Download Action Button for IDE -->
      <a
        href="#install-modal"
        data-modal-open="appimage-ide"
        class="bg-[#0066ff] hover:bg-blue-500 text-white text-xs font-medium px-5 py-2.5 rounded-lg shadow-lg shadow-blue-600/20 transition-all flex items-center justify-center space-x-2 active:scale-95 shrink-0"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        <span>Descargar AppImage IDE (x64)</span>
      </a>
    </div>

    <!-- Details Row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono pt-1 text-zinc-400">
      <div class="bg-[#060608] border border-zinc-800/60 p-3 rounded-md">
        <div class="text-[10px] text-zinc-500 uppercase">Formato</div>
        <div class="text-zinc-200 font-semibold font-sans mt-0.5">AppImage Standalone (x86_64)</div>
      </div>
      <div class="bg-[#060608] border border-zinc-800/60 p-3 rounded-md">
        <div class="text-[10px] text-zinc-500 uppercase">Compatibilidad</div>
        <div class="text-zinc-200 font-semibold font-sans mt-0.5">Ubuntu, Debian, Fedora, Arch & todas</div>
      </div>
      <div class="bg-[#060608] border border-zinc-800/60 p-3 rounded-md flex items-center justify-between">
        <div>
          <div class="text-[10px] text-zinc-500 uppercase">Hash Integridad</div>
          <div class="text-zinc-300 text-[11px] truncate max-w-[120px]">3f2a1b0c9a8f...</div>
        </div>
        <button 
          data-copy="sha256-appimage" 
          data-hash="3f2a1b0c9a8f9c2d1e4b3017fa98e3b2c1d0f97e6f5d4c3b2a1098987b6c5d4e"
          class="copy-btn px-2 py-1 text-[10px] bg-zinc-900 hover:bg-zinc-800 text-zinc-300 border border-zinc-800 rounded transition-colors"
          title="Copiar Hash SHA-256"
        >
          SHA-256 📋
        </button>
      </div>
    </div>
  </div>

  <!-- Product 3: Antigravity CLI (Oficial Google Install) -->
  <div class="border border-zinc-800/80 rounded-xl bg-[#0c0c0e] p-6 space-y-4 shadow-xl">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-start space-x-3.5">
        <div class="w-10 h-10 rounded-lg bg-emerald-950/80 border border-emerald-800/50 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002-2z"></path>
          </svg>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h3 class="text-lg font-bold text-white tracking-tight">Antigravity CLI</h3>
            <span class="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800/60 px-2 py-0.5 rounded font-mono font-medium">Oficial Google</span>
          </div>
          <p class="text-xs text-zinc-400 mt-1">
            Interfaz oficial de línea de comandos para Linux. Instalación directa mediante el script oficial de Google.
          </p>
        </div>
      </div>
    </div>

    <!-- Official CLI Command snippet -->
    <div class="relative group pt-1">
      <div class="bg-[#050507] border border-zinc-800/90 rounded-lg p-3.5 font-mono text-xs text-emerald-400 overflow-x-auto flex items-center justify-between">
        <div class="flex items-center space-x-2 overflow-x-auto">
          <span class="text-zinc-500 select-none">$</span>
          <code class="text-zinc-200">curl -fsSL https://antigravity.google/cli/install.sh | bash</code>
        </div>
        <button 
          data-copy="cli-official-script"
          data-text="curl -fsSL https://antigravity.google/cli/install.sh | bash"
          class="copy-btn shrink-0 ml-4 bg-emerald-600 hover:bg-emerald-500 text-white font-sans text-[11px] font-medium px-3.5 py-1.5 rounded transition-all active:scale-95 shadow"
        >
          Copiar Comando
        </button>
      </div>
    </div>
  </div>

</div>
