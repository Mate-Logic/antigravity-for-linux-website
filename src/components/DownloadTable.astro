---
type ReleaseAsset = {
  name: string;
  browser_download_url: string;
  digest?: string | null;
  updated_at: string;
};

type GithubRelease = {
  tag_name: string;
  name: string;
  html_url: string;
  body?: string;
  assets: ReleaseAsset[];
};

type ReleaseInfo = {
  version: string;
  releaseUrl: string;
  downloadUrl: string;
  sha256: string;
  builtOn: string;
};

function extractVersion(release: GithubRelease, assetName: string): string | undefined {
  // Some repositories use a mutable "latest" tag, so prefer the release title.
  const sources = [release.name, release.tag_name, release.body, assetName];
  const versions = sources.flatMap((source) =>
    source?.match(/(?:^|[^\d])v?(\d+\.\d+(?:\.\d+)*)(?!\d)/g) ?? [],
  );

  return versions.at(-1)?.match(/\d+\.\d+(?:\.\d+)*/)?.[0];
}

async function fetchLatestRelease(repo: string): Promise<ReleaseInfo> {
  const headers: Record<string, string> = {
    Accept: 'application/vnd.github+json',
    'User-Agent': 'antigravity-for-linux-website',
  };
  // Los runners comparten el límite anónimo de la API; en CI se usa el token del workflow.
  if (process.env.GITHUB_TOKEN) headers.Authorization = `Bearer ${process.env.GITHUB_TOKEN}`;

  const response = await fetch(`https://api.github.com/repos/${repo}/releases/latest`, { headers });
  if (!response.ok) throw new Error(`GitHub API returned ${response.status} for ${repo}`);

  const data = (await response.json()) as GithubRelease;
  const appImage = data.assets.find(
    (asset) => asset.name.endsWith('.AppImage') && !asset.name.endsWith('.AppImage.zsync'),
  );
  if (!appImage) throw new Error(`The latest release for ${repo} has no AppImage asset`);

  const version = extractVersion(data, appImage.name);
  if (!version) throw new Error(`Could not determine the version for ${repo}`);

  let sha256 = appImage.digest?.replace(/^sha256:/, '') ?? '';
  if (!sha256 && data.body) {
    const match = data.body.match(/`([a-fA-F0-9]{64})`/);
    if (match) sha256 = match[1];
  }
  if (!sha256) throw new Error(`The latest release for ${repo} has no SHA-256 checksum`);

  return {
    version,
    releaseUrl: data.html_url,
    downloadUrl: appImage.browser_download_url,
    sha256,
    // El asset se reemplaza en cada compilación, así que su fecha es la del último build.
    builtOn: appImage.updated_at.slice(0, 10),
  };
}

type OfficialAppImage = {
  version: string;
  downloadUrl: string;
  debUrl?: string;
  sha512: string;
  publishedOn?: string;
};

// Google no enlaza el AppImage de Antigravity 2.0 en su página de descargas, pero lo
// publica en el manifiesto que consulta el auto-updater de la app (resources/app-update.yml).
const HUB_MANIFEST_URL =
  'https://antigravity-hub-auto-updater-974169037036.us-central1.run.app/manifest/latest-x64-linux.yml';

async function fetchOfficialAppImage(): Promise<OfficialAppImage> {
  const response = await fetch(HUB_MANIFEST_URL, {
    headers: { 'User-Agent': 'antigravity-for-linux-website' },
  });
  if (!response.ok) throw new Error(`The Antigravity update manifest returned ${response.status}`);
  const manifest = await response.text();

  const version = manifest.match(/^version:\s*(\d+\.\d+\.\d+)\s*$/m)?.[1];
  const files = [...manifest.matchAll(/-\s*url:\s*(\S+)\s+sha512:\s*(\S+)/g)].map(([, url, sha512]) => ({ url, sha512 }));
  const appImage = files.find((file) => file.url.endsWith('/Antigravity.AppImage'));
  if (!version || !appImage) throw new Error('The Antigravity update manifest has no AppImage entry');

  // El manifiesto usa SHA-512 en base64 (formato electron-updater); se muestra en hex
  // para poder compararlo directamente con la salida de sha512sum.
  const sha512 = Buffer.from(appImage.sha512, 'base64').toString('hex');

  const head = await fetch(appImage.url, { method: 'HEAD' });
  if (!head.ok) throw new Error(`The official AppImage returned ${head.status}`);
  const lastModified = head.headers.get('last-modified');

  return {
    version,
    downloadUrl: appImage.url,
    debUrl: files.find((file) => file.url.endsWith('/Antigravity.deb'))?.url,
    sha512,
    publishedOn: lastModified ? new Date(lastModified).toISOString().slice(0, 10) : undefined,
  };
}

const v2Release = await fetchOfficialAppImage();

const ideRelease = await fetchLatestRelease('Mate-Logic/AntigravityIDE-AppImage');
