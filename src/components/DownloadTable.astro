              <span class="text-zinc-500 block text-[10px] uppercase tracking-wider mb-0.5" data-i18n="arch-label">Architecture</span>
              <span class="text-purple-300 font-semibold font-mono">x86_64 (64-bit)</span>
            </div>
          </div>

          <div class="bg-[#090710] border border-purple-900/60 p-3 rounded-xl space-y-1.5 shadow-inner">
            <div class="flex items-center justify-between">
              <span class="text-[10px] text-zinc-400 font-semibold uppercase tracking-wider flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                <span data-i18n="sha512-label">Official SHA-512 Checksum</span>
              </span>
              <button 
                data-copy="sha512-v2" 
                data-hash={v2Release.sha512}
                class="copy-btn text-[10px] bg-purple-950/80 hover:bg-purple-800/80 text-purple-200 border border-purple-700/60 px-2 py-1 rounded-md transition-colors flex items-center gap-1"
              >
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002-2V7a2 2 0 002-2h2m0 0h2a2 2 0 012 2v1h-4V7a2 2 0 012-2zm2 5h4m-4 4h4m-4 4h4"></path>
