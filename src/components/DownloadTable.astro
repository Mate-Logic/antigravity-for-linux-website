          <p class="text-xs text-zinc-400 mt-2 leading-relaxed" data-i18n="v2-desc">
            Standalone AI desktop agent application (Non-IDE) for Linux. This is Google's own official AppImage, downloaded directly from Google's servers.
          </p>
        </div>

        <!-- Format, Architecture & Visible SHA-256 -->
        <div class="space-y-2.5 font-mono text-xs pt-2">
          <div class="grid grid-cols-2 gap-2 text-[11px]">
            <div class="bg-[#090710] border border-purple-950/80 p-2.5 rounded-lg">
