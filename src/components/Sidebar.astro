---
// Sidebar.astro - Barra lateral inspirada en la interfaz de la captura de pantalla
---

<aside class="w-64 bg-[#08080a] border-r border-zinc-800/80 flex flex-col justify-between shrink-0 min-h-screen text-xs select-none">
  <div>
    <!-- Brand / Workspace Switcher Header -->
    <div class="h-14 px-5 flex items-center border-b border-zinc-800/80">
      <div class="flex items-center space-x-2.5 cursor-pointer group">
        <div class="w-5 h-5 bg-white rounded flex items-center justify-center text-black font-bold text-[11px] shadow-sm group-hover:scale-105 transition-transform">
          <svg class="w-3.5 h-3.5 text-black fill-current" viewBox="0 0 24 24">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
          </svg>
        </div>
        <span class="font-semibold text-zinc-100 text-sm tracking-tight">Antigravity</span>
        <span class="text-zinc-500 text-[10px] bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded font-mono">Linux</span>
        <svg class="w-3.5 h-3.5 text-zinc-500 group-hover:text-zinc-300 transition-colors ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </div>
    </div>

    <!-- Navigation Menu -->
    <nav class="py-6 px-3 space-y-1">
      <button 
        data-tab="descargas"
        class="tab-btn active w-full flex items-center px-3 py-2.5 rounded-md text-left text-zinc-100 font-medium transition-all group relative border-l-2 border-white bg-zinc-900/60"
      >
        <svg class="w-4 h-4 mr-3 text-blue-400 group-hover:text-blue-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        <span>Descargas</span>
      </button>

      <button 
        data-tab="instalacion"
        class="tab-btn w-full flex items-center px-3 py-2.5 rounded-md text-left text-zinc-400 hover:text-zinc-100 font-medium transition-all group border-l-2 border-transparent hover:bg-zinc-900/40"
      >
        <svg class="w-4 h-4 mr-3 text-zinc-500 group-hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span>Instalación CLI</span>
      </button>

      <button 
        data-tab="claves"
        class="tab-btn w-full flex items-center px-3 py-2.5 rounded-md text-left text-zinc-400 hover:text-zinc-100 font-medium transition-all group border-l-2 border-transparent hover:bg-zinc-900/40"
      >
        <svg class="w-4 h-4 mr-3 text-zinc-500 group-hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
        </svg>
        <span>Claves API & GPG</span>
      </button>

      <button 
        data-tab="repositorios"
        class="tab-btn w-full flex items-center px-3 py-2.5 rounded-md text-left text-zinc-400 hover:text-zinc-100 font-medium transition-all group border-l-2 border-transparent hover:bg-zinc-900/40"
      >
        <svg class="w-4 h-4 mr-3 text-zinc-500 group-hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
        </svg>
        <span>Repositorios</span>
      </button>

      <button 
        data-tab="compatibilidad"
        class="tab-btn w-full flex items-center px-3 py-2.5 rounded-md text-left text-zinc-400 hover:text-zinc-100 font-medium transition-all group border-l-2 border-transparent hover:bg-zinc-900/40"
      >
        <svg class="w-4 h-4 mr-3 text-zinc-500 group-hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>Compatibilidad</span>
      </button>

      <button 
        data-tab="historial"
        class="tab-btn w-full flex items-center px-3 py-2.5 rounded-md text-left text-zinc-400 hover:text-zinc-100 font-medium transition-all group border-l-2 border-transparent hover:bg-zinc-900/40"
      >
        <svg class="w-4 h-4 mr-3 text-zinc-500 group-hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>Changelog</span>
      </button>
    </nav>
  </div>

  <!-- Bottom Info / User Branding matching screenshot footer style -->
  <div class="p-4 border-t border-zinc-800/80 space-y-3">
    <div class="flex items-center space-x-2 text-[11px] text-zinc-400 bg-zinc-900/50 p-2 rounded-md border border-zinc-800/60">
      <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
      <span class="font-mono text-zinc-300">Servidores Operativos</span>
    </div>
    
    <div class="text-[11px] text-zinc-500 space-y-1 pt-1">
      <div class="flex items-center justify-between">
        <span>v1.4.0-linux</span>
        <a href="https://github.com" target="_blank" class="text-zinc-400 hover:text-white transition-colors">GitHub ↗</a>
      </div>
    </div>
  </div>
</aside>
