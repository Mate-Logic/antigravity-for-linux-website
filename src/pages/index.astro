---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import DownloadTable from '../components/DownloadTable.astro';
import InstallModal from '../components/InstallModal.astro';
import Toast from '../components/Toast.astro';
---

<Layout
  title="Antigravity for Linux - AppImage and IDE Downloads"
  description="Download Antigravity for Linux as a portable AppImage or install the official CLI. Community-maintained Linux downloads for Ubuntu, Debian, Fedora, and Arch."
>
  <div class="min-h-screen bg-[#08080a] flex flex-col">
    <!-- Main Sticky Header Navigation -->
    <Header />

    <!-- Main Content Body -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-6 py-10 space-y-12">
      
      <!-- Hero Banner Section -->
      <section class="text-center py-6 space-y-4 border-b border-zinc-900 pb-10">
        <div class="inline-flex items-center space-x-2 bg-amber-950/40 border border-amber-800/40 px-3.5 py-1.5 rounded-full text-xs text-amber-300">
          <img src={`${import.meta.env.BASE_URL}images/Antigravity_CLI.svg`} alt="Antigravity Logo" class="w-4 h-4 object-contain" />
          <span data-i18n="hero-badge">Unofficial Community Downloads • Linux (x86_64)</span>
        </div>
        
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight" data-i18n="hero-title">
          Antigravity for Linux
        </h1>

        <p class="text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed" data-i18n="hero-subtitle">
          Antigravity downloads for Linux: Google's official AppImage of Antigravity 2.0, a community-built AppImage of the IDE, and the official CLI installer.
        </p>
      </section>

      <!-- Section: Segmented Responsive Product Cards Grid -->
      <section class="space-y-6" aria-labelledby="downloads-heading">
        <h2 id="downloads-heading" class="sr-only">Antigravity Linux downloads</h2>
        <DownloadTable />
      </section>

    </main>

    <!-- Clean Footer with Disclaimer and Language Selector -->
    <footer class="border-t border-zinc-900 bg-[#060608] py-8 text-xs text-zinc-500 font-mono mt-auto">
      <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
        <!-- Unofficial Disclaimer -->
        <p class="text-[11px] text-zinc-500 max-w-2xl text-center md:text-left leading-relaxed" data-i18n="disclaimer">
          Disclaimer: This is an unofficial community project. Antigravity and its trademarks belong to Google LLC. The Antigravity 2.0 AppImage and the CLI are downloaded directly from Google; the IDE AppImage is built by the community from Google's official Linux release.
        </p>

        <!-- Footer Language Indicator -->
        <div class="flex items-center space-x-2 shrink-0 bg-zinc-900/60 border border-zinc-800 px-3 py-1.5 rounded-lg">
          <span class="text-zinc-400 font-sans font-medium" data-i18n="lang-indicator">Language: English</span>
        </div>
      </div>
    </footer>

    <!-- Modals & Toasts -->
    <InstallModal />
    <Toast />
  </div>

  <!-- Client-side i18n & Interactive Logic -->
  <script>
    // Translation Dictionary (EN & ES)
    const translations: Record<string, Record<string, string>> = {
      en: {
        'hero-badge': 'Unofficial Community Downloads • Linux (x86_64)',
        'hero-title': 'Antigravity for Linux',
        'hero-subtitle': "Antigravity downloads for Linux: Google's official AppImage of Antigravity 2.0, a community-built AppImage of the IDE, and the official CLI installer.",
        'disclaimer': "Disclaimer: This is an unofficial community project. Antigravity and its trademarks belong to Google LLC. The Antigravity 2.0 AppImage and the CLI are downloaded directly from Google; the IDE AppImage is built by the community from Google's official Linux release.",
        'lang-indicator': 'Language: English',
        
        // Cards
        'v2-tag': 'Desktop Agent',
        'recommended': 'Recommended',
        'v2-official': 'Official Google',
        'published-label': 'Published by Google on',
        'v2-desc': "Standalone AI desktop agent application (Non-IDE) for Linux. This is Google's own official AppImage, downloaded directly from Google's servers.",
        'v2-btn': 'Download official AppImage v{version} (x64)',
        'v2-deb': 'Also available: official .deb package',
        'v2-source-title': 'Where does this link come from?',
        'v2-source-desc': "Google doesn't list this AppImage on its download page. It is published in the auto-update manifest that the Antigravity app itself checks (referenced in resources/app-update.yml inside the official .tar.gz). This site reads that manifest on every build, so the link always points to Google's latest version.",
        'v2-source-link': 'View the official manifest',
        
        'ide-tag': 'Full IDE',
        'ide-desc': "Complete development environment for Linux. Google doesn't ship an AppImage of the IDE, so the community builds this 64-bit portable AppImage from Google's official Linux release.",
        'ide-btn': 'Download AppImage IDE v{version} (x64)',

        'cli-tag': 'Official Google',
        'cli-desc': 'Official command-line interface for Linux. Direct installation via official Google script.',
        'cli-cmd-label': 'Terminal Command:',
        'cli-btn': 'Copy Command',

        'format-label': 'Format',
        'arch-label': 'Architecture',
        'sha256-label': 'SHA-256 Checksum',
        'sha512-label': 'Official SHA-512 Checksum',
        'built-label': 'Built on',
        'copy-btn-text': 'Copy',
        'copied': 'Copied to clipboard!',

        // Gear Lever Recommendation
        'gearlever-tag': '⚡ Recommended AppImage Manager',
        'gearlever-title': 'Easily integrate AppImages into your Linux Menu & Taskbar with Gear Lever',
        'gearlever-desc': 'We recommend using Gear Lever to manage your AppImages. It automatically creates system desktop shortcuts, sets application icons, pins AppImages to your taskbar/dock, and handles updates seamlessly.',
        'gearlever-btn': 'Get Gear Lever on Flathub'
      },
      es: {
        'hero-badge': 'Descargas Comunitarias No Oficiales • Linux (x86_64)',
        'hero-title': 'Antigravity para Linux',
        'hero-subtitle': 'Descargas de Antigravity para Linux: el AppImage oficial de Google de Antigravity 2.0, un AppImage del IDE compilado por la comunidad y el instalador oficial del CLI.',
        'disclaimer': 'Aviso: Este es un proyecto comunitario no oficial. Antigravity y sus marcas registradas pertenecen a Google LLC. El AppImage de Antigravity 2.0 y el CLI se descargan directamente de Google; el AppImage del IDE lo compila la comunidad a partir del lanzamiento oficial de Google para Linux.',
        'lang-indicator': 'Idioma: Español',

        // Cards
        'v2-tag': 'Agente de Escritorio',
        'recommended': 'Recomendado',
        'v2-official': 'Oficial de Google',
        'published-label': 'Publicado por Google el',
        'v2-desc': 'Aplicación de escritorio independiente de agente de IA (No-IDE) para Linux. Es el AppImage oficial de Google, descargado directamente desde los servidores de Google.',
        'v2-btn': 'Descargar AppImage oficial v{version} (x64)',
        'v2-deb': 'También disponible: paquete .deb oficial',
        'v2-source-title': '¿De dónde sale este enlace?',
        'v2-source-desc': 'Google no muestra este AppImage en su página de descargas. Está publicado en el manifiesto de auto-actualización que consulta la propia app de Antigravity (referenciado en resources/app-update.yml dentro del .tar.gz oficial). Este sitio lee ese manifiesto en cada compilación, así que el enlace siempre apunta a la última versión de Google.',
        'v2-source-link': 'Ver el manifiesto oficial',

        'ide-tag': 'IDE Completo',
        'ide-desc': 'Entorno de desarrollo integral para Linux. Google no publica un AppImage del IDE, así que la comunidad compila este AppImage portable de 64 bits a partir del lanzamiento oficial de Google para Linux.',
        'ide-btn': 'Descargar AppImage IDE v{version} (x64)',

        'cli-tag': 'Oficial Google',
        'cli-desc': 'Interfaz oficial de línea de comandos para Linux. Instalación directa mediante el script oficial de Google.',
        'cli-cmd-label': 'Comando de Terminal:',
        'cli-btn': 'Copiar Comando',

        'format-label': 'Formato',
        'arch-label': 'Arquitectura',
        'sha256-label': 'Checksum SHA-256',
        'sha512-label': 'Checksum SHA-512 oficial',
        'built-label': 'Compilado el',
        'copy-btn-text': 'Copiar',
        'copied': '¡Copiado al portapapeles!',

        // Gear Lever Recommendation
        'gearlever-tag': '⚡ Gestor Recomendado de AppImages',
        'gearlever-title': 'Integra tus AppImages en el Menú y Barra de Tareas con Gear Lever',
        'gearlever-desc': 'Recomendamos usar Gear Lever para gestionar tus AppImages. Crea acceso directo en el menú de aplicaciones, establece íconos, ancla las aplicaciones a la barra de tareas y gestiona actualizaciones de forma automática.',
        'gearlever-btn': 'Ver Gear Lever en Flathub'
      }
    };

    document.addEventListener('DOMContentLoaded', () => {
      // Current language state (default: 'en')
      let currentLang = localStorage.getItem('antigravity_lang') || 'en';

      const btnEn = document.getElementById('lang-btn-en');
      const btnEs = document.getElementById('lang-btn-es');
      const toast = document.getElementById('toast-notification');
      const toastMsg = document.getElementById('toast-message');

      function updateLanguage(lang: string) {
        currentLang = lang;
        localStorage.setItem('antigravity_lang', lang);

        // Update active button state in header
        if (lang === 'en') {
          btnEn?.classList.add('bg-blue-600', 'text-white', 'shadow-sm');
          btnEn?.classList.remove('text-zinc-400');
          btnEs?.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
          btnEs?.classList.add('text-zinc-400');
        } else {
          btnEs?.classList.add('bg-blue-600', 'text-white', 'shadow-sm');
          btnEs?.classList.remove('text-zinc-400');
          btnEn?.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
          btnEn?.classList.add('text-zinc-400');
        }

        // Apply translations
        const langDict = translations[lang] || translations.en;
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (key && langDict[key]) {
            const version = el.getAttribute('data-v2-version') || el.getAttribute('data-release-version') || '';
            el.textContent = langDict[key].replace('{version}', version);
          }
        });
      }

      // Button event listeners
      btnEn?.addEventListener('click', () => updateLanguage('en'));
      btnEs?.addEventListener('click', () => updateLanguage('es'));

      // Initialize language
      updateLanguage(currentLang);

      // Toast notification helper
      function showToast(messageKey: string) {
        if (!toast || !toastMsg) return;
        const dict = translations[currentLang] || translations.en;
        toastMsg.textContent = dict[messageKey] || messageKey;
        toast.classList.remove('translate-y-12', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-12', 'opacity-0');
        }, 2500);
      }

      // Clipboard Copy Handlers
      document.querySelectorAll<HTMLElement>('.copy-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const textToCopy = btn.getAttribute('data-text') || btn.getAttribute('data-hash');
          if (textToCopy) {
            navigator.clipboard.writeText(textToCopy);
            showToast('copied');
          }
        });
      });

      // Modal Controls
      const modal = document.getElementById('install-modal');
      const modalClose = document.getElementById('modal-close');
      const modalDone = document.getElementById('modal-done-btn');
      const modalTitle = document.getElementById('modal-title');
      const modalCmds = document.getElementById('modal-commands');
      const directDownload = document.getElementById('direct-download-link') as HTMLAnchorElement;

      function openModal(format: string) {
        if (!modal || !modalTitle || !modalCmds || !directDownload) return;

        let titleText = 'Downloading Antigravity AppImage...';
        let commandsHTML = '';
        let downloadFile = 'Antigravity-2.0-Desktop-Agent-x86_64.AppImage';

        if (format === 'appimage-2') {
          titleText = currentLang === 'es' ? 'Descargando Antigravity-2.0-Desktop-Agent-x86_64.AppImage' : 'Downloading Antigravity-2.0-Desktop-Agent-x86_64.AppImage';
          downloadFile = 'Antigravity-2.0-Desktop-Agent-x86_64.AppImage';
          commandsHTML = `
            <p class="text-zinc-500"># ${currentLang === 'es' ? 'Dar permisos de ejecución e iniciar Antigravity 2.0' : 'Make executable and run Antigravity 2.0'}</p>
            <p>chmod +x Antigravity-2.0-Desktop-Agent-x86_64.AppImage</p>
            <p>./Antigravity-2.0-Desktop-Agent-x86_64.AppImage</p>
          `;
        } else if (format === 'appimage-ide' || format === 'appimage') {
          titleText = currentLang === 'es' ? 'Descargando Antigravity-IDE-1.4.0-x86_64.AppImage' : 'Downloading Antigravity-IDE-1.4.0-x86_64.AppImage';
          downloadFile = 'Antigravity-IDE-1.4.0-x86_64.AppImage';
          commandsHTML = `
            <p class="text-zinc-500"># ${currentLang === 'es' ? 'Dar permisos de ejecución e iniciar Antigravity IDE' : 'Make executable and run Antigravity IDE'}</p>
            <p>chmod +x Antigravity-IDE-1.4.0-x86_64.AppImage</p>
            <p>./Antigravity-IDE-1.4.0-x86_64.AppImage</p>
          `;
        }

        modalTitle.textContent = titleText;
        modalCmds.innerHTML = commandsHTML;
        directDownload.setAttribute('href', `#download-${downloadFile}`);
        directDownload.setAttribute('download', downloadFile);

        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('flex');
        modal.classList.add('hidden');
      }

      document.querySelectorAll('[data-modal-open]').forEach(trigger => {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          const format = trigger.getAttribute('data-modal-open') || 'appimage-2';
          openModal(format);
        });
      });

      if (modalClose) modalClose.addEventListener('click', closeModal);
      if (modalDone) modalDone.addEventListener('click', closeModal);

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    });
  </script>
</Layout>
